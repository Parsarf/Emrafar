{
  "version": 1,
  "source": "assets/css/styles.css",
  "colors": {
    "ink": "#143547",
    "muted": "#536a76",
    "blue": "#1677a9",
    "sky": "#eaf5fb",
    "sky-strong": "#c9e8f6",
